{
  "name": "thomas-thony/safephp",
  "autoload": {
    "psr-4": {
      "SafePHP\\": "src/"
    }
  },
  "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
  "description": "A cyber-security library for your php project",
  "type": "library",
  "authors": [
    {
      "name": "Thomas Thony",
      "email": "thomas.thony.69@gmail.com"
    }
  ],
  "license": "GPL-3.0-or-later",
  "minimum-stability": "alpha",
  "require": {
    "php": ">=8.0.0",
    "vlucas/phpdotenv": "^5.6",
    "phpdocumentor/shim": "^3.9",
    "phpmailer/phpmailer": "^7.0",
    "monolog/monolog": "^3.10",
    "cyclonedx/cyclonedx-php-composer": "^6.1.0"
  }, 
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "config": {
    "allow-plugins": {
      "phpdocumentor/shim": true,
      "cyclonedx/cyclonedx-php-composer": true
    }
  }
}
